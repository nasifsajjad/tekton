# Copy to .env.local and change the password before deploying.
# This is the password for the /admin site editor.
ADMIN_PASSWORD=change-me-before-launch

# Optional Google reCAPTCHA v2 ("I'm not a robot" checkbox). The form works
# without it; once both values are configured, CAPTCHA is required automatically.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
