# Copy to .env.local and change the password before deploying.
# This is the password for the /admin site editor.
ADMIN_PASSWORD=change-me-before-launch

# Google reCAPTCHA v2 ("I'm not a robot" checkbox). Register the production
# domain in the Google reCAPTCHA console, then add both values to the host.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
